{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisharedresponsibility.com/schemas/sector-model-map.schema.json",
  "title": "Sector operating model to SRF model map",
  "description": "Schema for data/sector-model-map.json. Each sector model name maps to exactly one of the four SRF v1.0 models.",
  "type": "object",
  "additionalProperties": false,
  "required": ["updated", "description", "edit_rule", "srf_models", "mappings"],
  "properties": {
    "updated": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "edit_rule": { "type": "string", "minLength": 1 },
    "srf_models": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "definition", "source"],
        "properties": {
          "id": { "type": "string", "enum": ["AI-SaaS", "AI-PaaS", "Agent-PaaS", "IaaS"] },
          "name": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector_model", "srf_model", "verticals", "definition", "definition_source", "rationale"],
      "properties": {
        "sector_model": {
          "type": "string",
          "enum": [
            "SaMD-Cloud",
            "EHR-Embedded",
            "Agent-Clinical",
            "On-Premise",
            "Agent-Ops",
            "Program-Embedded",
            "Vendor-Model",
            "Shared-Service",
            "OT-Edge",
            "Product-Embedded"
          ]
        },
        "srf_model": {
          "type": "string",
          "enum": ["AI-SaaS", "AI-PaaS", "Agent-PaaS", "IaaS"]
        },
        "verticals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["finance", "healthcare", "insurance", "public-sector", "defense", "manufacturing"]
          }
        },
        "definition": { "type": "string", "minLength": 1 },
        "definition_source": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "alternative": {
          "type": "object",
          "additionalProperties": false,
          "required": ["srf_model", "why"],
          "properties": {
            "srf_model": {
              "type": "string",
              "enum": ["AI-SaaS", "AI-PaaS", "Agent-PaaS", "IaaS"]
            },
            "why": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
