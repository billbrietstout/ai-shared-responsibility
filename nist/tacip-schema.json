{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TACIP profile node",
  "description": "A Practice, Task, or Implementation node in the Trustworthy AI in Critical Infrastructure Profile.",
  "type": "object",
  "required": [
    "id",
    "level",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+){0,2}$",
      "description": "Stable identifier. Dot-depth encodes level."
    },
    "level": {
      "enum": [
        "practice",
        "task",
        "implementation"
      ]
    },
    "anchor": {
      "type": "string",
      "description": "URL-safe anchor for deep linking."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "related_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trustworthiness_characteristics": {
      "type": "array",
      "items": {
        "enum": [
          "Safe",
          "Secure",
          "Resilient",
          "Explainable & Interpretable",
          "Accountable & Transparent",
          "Privacy Enhanced",
          "Fair",
          "Accurate, Valid, Reliable, & Bias Managed"
        ]
      },
      "description": "CI-adapted trustworthiness characteristics addressed by this node."
    },
    "ai_rmf_mappings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "NIST AI RMF (AI 100-1) Function/Category/Subcategory references."
    },
    "cyber_ai_profile_mappings": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "mapped",
            "pending"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "framework": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "description": "Mapping to NIST IR 8596 (Cyber AI Profile). Explicitly 'pending' until IR 8596 is finalized."
    },
    "proposed": {
      "type": "array",
      "description": "Reviewer/team-proposed additions (TBD-*/CAND-*) that fill the draft's TBD and Candidate fields. NOT part of the NIST draft.",
      "items": {
        "type": "object",
        "required": [
          "source",
          "field",
          "text"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "citation"
        ],
        "properties": {
          "citation": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Specific clauses/sections that carry the transferable utility."
          }
        }
      }
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Typed edges to other nodes (the profile's internal graph)."
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#"
      }
    },
    "implementations": {
      "type": "array",
      "items": {
        "$ref": "#"
      }
    }
  }
}