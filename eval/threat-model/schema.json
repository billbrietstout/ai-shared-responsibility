            "product": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "component_referent": { "type": "string", "minLength": 1 },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
