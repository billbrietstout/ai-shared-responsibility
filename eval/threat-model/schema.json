{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisharedresponsibility.com/eval/threat-model/schema.json",
  "title": "AI system diagram threat matrix v2",
  "description": "JSON shape written by prompt pack v2. Track A fills inventory, adversary, diagram-visible controls and control absences, method coverage, threats, QA, and report. Track B may fill threats[].srf before P-report.",
  "type": "object",
  "required": [
    "system_name",
    "perspective",
    "representation",
    "inventory",
    "solution_description",
    "llm_subset",
    "llm_subset_empty",
    "stride_coverage",
    "phantom_coverage",
    "threats",
    "qa"
  ],
  "additionalProperties": true,
  "properties": {
    "system_name": { "type": "string", "minLength": 1 },
    "perspective": { "type": "string", "minLength": 1 },
    "representation": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["image", "mermaid", "svg"] },
        "sha256": { "type": "string" },
        "source_id": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "inventory": { "$ref": "#/$defs/inventory" },
    "architecture_description": { "type": "string" },
    "application_details": { "type": "string" },
    "key_features": {
      "type": "array",
      "items": { "type": "string" }
    },
    "in_scope": {
      "type": "array",
      "items": { "$ref": "#/$defs/scope_item" }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "$ref": "#/$defs/scope_item" }
    },
    "replica_coverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/replica_coverage" }
    },
    "adversary": { "$ref": "#/$defs/adversary" },
    "existing_controls": {
      "type": "array",
      "items": { "$ref": "#/$defs/existing_control" }
    },
    "control_absences": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_absence" }
    },
    "none_drawn": { "type": "boolean" },
    "claim_boundary": { "$ref": "#/$defs/claim_boundary" },
    "solution_description": { "type": "string" },
    "report": { "$ref": "#/$defs/report" },
    "llm_subset": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Component ids that receive PHANTOM-B elicitation."
    },
    "llm_subset_empty": {
      "type": "boolean",
      "description": "True exactly when llm_subset is empty. An empty subset makes PHANTOM-B not applicable, not complete."
    },
    "llm_subset_decision": { "$ref": "#/$defs/llm_subset_decision" },
    "stride_considerations": {
      "type": "array",
      "items": { "$ref": "#/$defs/consideration" }
    },
    "stride_coverage": { "$ref": "#/$defs/stride_coverage" },
    "phantom_considerations": {
      "type": "array",
      "items": { "$ref": "#/$defs/consideration" }
    },
    "phantom_coverage": { "$ref": "#/$defs/phantom_coverage" },
    "threats": {
      "type": "array",
      "items": { "$ref": "#/$defs/threat" }
    },
    "review_order": {
      "type": "array",
      "items": { "$ref": "#/$defs/review_order_item" }
    },
    "qa": { "$ref": "#/$defs/qa" },
    "chain_meta": {
      "type": "object",
      "properties": {
        "prompt_pack_version": {
          "type": "string",
          "const": "2.0",
          "description": "Must equal the root version in prompts.json."
        },
        "role": { "type": "string" },
        "method": { "type": "string" },
        "date": { "type": "string" },
        "reviewer": { "type": ["string", "null"] },
        "track_b_applied": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["llm_subset_empty"],
        "properties": {
          "llm_subset_empty": { "const": true }
        }
      },
      "then": {
        "properties": {
          "llm_subset": { "type": "array", "maxItems": 0 },
          "phantom_coverage": {
            "type": "object",
            "properties": {
              "status": { "const": "not_applicable" }
            }
          },
          "qa": {
            "type": "object",
            "properties": {
              "llm_subset_empty": { "const": true },
              "phantom_b_complete": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["llm_subset_empty"],
        "properties": {
          "llm_subset_empty": { "const": false }
        }
      },
      "then": {
        "properties": {
          "llm_subset": { "type": "array", "minItems": 1 },
          "phantom_coverage": {
            "type": "object",
            "properties": {
              "status": {
                "enum": ["complete", "incomplete"]
              }
            }
          },
          "qa": {
            "type": "object",
            "properties": {
              "llm_subset_empty": { "const": false },
              "phantom_b_complete": { "type": "boolean" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "adversary": {
      "type": "object",
      "properties": {
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "positions": {
          "type": "array",
          "items": { "$ref": "#/$defs/attacker_position" }
        }
      }
    },
    "attacker_position": {
      "type": "object",
      "required": ["id", "zone", "actor", "already_can"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "zone": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "already_can": { "type": "string", "minLength": 1 }
      }
    },
    "existing_control": {
      "type": "object",
      "required": [
        "id",
        "name",
        "diagram_referent",
        "kind",
        "coverage_referents",
        "coverage_basis"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "diagram_referent": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": [
            "authn",
            "tls",
            "filter",
            "isolation",
            "logging",
            "approval",
            "network",
            "identity",
            "other"
          ]
        },
        "coverage_referents": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Inventory ids visibly protected by a connection, containment relation, label, or badge."
        },
        "coverage_basis": {
          "type": "string",
          "enum": [
            "connected",
            "contained",
            "label_only",
            "badge_only",
            "unknown"
          ]
        }
      }
    },
    "control_absence": {
      "type": "object",
      "required": ["id", "kind", "expected_referent", "observation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^gap-ctl-[a-z0-9-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "authn",
            "tls",
            "filter",
            "isolation",
            "logging",
            "approval",
            "network",
            "identity",
            "other"
          ]
        },
        "expected_referent": { "type": "string", "minLength": 1 },
        "observation": {
          "type": "string",
          "minLength": 1,
          "description": "Diagram-grounded statement that the representation does not show the control."
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "properties": {
        "does_not_claim": {
          "type": "array",
          "items": { "type": "string" }
        },
        "box": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["kind", "detail"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["test", "log", "fail_condition"]
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "report": {
      "type": "object",
      "required": ["markdown"],
      "properties": {
        "title": { "type": "string" },
        "markdown": { "type": "string", "minLength": 1 },
        "reviewer": { "type": ["string", "null"] }
      }
    },
    "inventory": {
      "type": "object",
      "required": [
        "components",
        "external_actors",
        "data_stores",
        "data_flows",
        "trust_boundaries",
        "llm_components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/named" }
        },
        "external_actors": {
          "type": "array",
          "items": { "$ref": "#/$defs/named" }
        },
        "data_stores": {
          "type": "array",
          "items": { "$ref": "#/$defs/named" }
        },
        "data_flows": {
          "type": "array",
          "items": { "$ref": "#/$defs/flow" }
        },
        "trust_boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/boundary" }
        },
        "llm_components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_trust_boundaries": { "type": "boolean" }
      }
    },
    "named": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["process", "store", "external", "actor"]
        },
        "replica_of": { "type": ["string", "null"] },
        "replica_evidence": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "flow": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string" },
        "crosses_boundary": { "type": ["string", "null"] }
      }
    },
    "boundary": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contains": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "scope_item": {
      "type": "object",
      "required": ["id", "rationale"],
      "properties": {
        "id": { "type": "string" },
        "rationale": { "type": "string" }
      }
    },
    "replica_element_pair": {
      "type": "object",
      "required": ["representative_id", "replica_id"],
      "properties": {
        "representative_id": { "type": "string", "minLength": 1 },
        "replica_id": { "type": "string", "minLength": 1 }
      }
    },
    "replica_coverage": {
      "type": "object",
      "required": [
        "representative_id",
        "replica_id",
        "evidence",
        "inherited_element_pairs",
        "divergence_gap",
        "divergence_threat_id"
      ],
      "properties": {
        "representative_id": { "type": "string", "minLength": 1 },
        "replica_id": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "inherited_element_pairs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/replica_element_pair" }
        },
        "divergence_gap": { "type": "string", "minLength": 1 },
        "divergence_threat_id": {
          "type": ["string", "null"],
          "pattern": "^T[0-9]+$"
        }
      }
    },
    "llm_subset_decision": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "possible_miss",
            "needs_operator_confirmation",
            "continue_without_llm"
          ]
        },
        "reason": { "type": "string" }
      }
    },
    "consideration": {
      "type": "object",
      "required": [
        "element_id",
        "letter",
        "status",
        "diagram_referent",
        "evidence_refs"
      ],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "letter": {
          "type": "string",
          "enum": [
            "S",
            "T",
            "R",
            "I",
            "D",
            "E",
            "P",
            "H",
            "A",
            "N",
            "O",
            "M",
            "B"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["scenario", "not_applicable"]
        },
        "scenario": { "type": "string" },
        "reason": { "type": "string" },
        "diagram_referent": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "attacker_position": { "type": "string" },
        "asset": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "scenario" } }
          },
          "then": {
            "required": ["scenario", "attacker_position", "asset"],
            "properties": {
              "scenario": { "type": "string", "minLength": 1 },
              "attacker_position": { "type": "string", "minLength": 1 },
              "asset": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "not_applicable" } }
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "stride_coverage": {
      "type": "object",
      "required": [
        "budget_rows",
        "letters_per_element",
        "expected_elements",
        "considered_elements",
        "remaining_elements",
        "rows_expected",
        "rows_written_total",
        "complete"
      ],
      "properties": {
        "budget_rows": { "type": "integer", "minimum": 6 },
        "letters_per_element": { "type": "integer", "const": 6 },
        "expected_elements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "considered_elements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "remaining_elements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rows_expected": { "type": "integer", "minimum": 0 },
        "rows_written_total": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      }
    },
    "phantom_missing": {
      "type": "object",
      "required": ["element_id", "letters"],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "letters": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["P", "H", "A", "N", "T", "O", "M", "B"]
          }
        }
      }
    },
    "phantom_coverage": {
      "type": "object",
      "required": [
        "status",
        "expected_elements",
        "complete_elements",
        "missing"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["complete", "incomplete", "not_applicable"]
        },
        "expected_elements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "complete_elements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "missing": {
          "type": "array",
          "items": { "$ref": "#/$defs/phantom_missing" }
        }
      }
    },
    "review_order_item": {
      "type": "object",
      "required": [
        "position",
        "threat_id",
        "attacker_position",
        "prerequisite_summary",
        "reason"
      ],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "threat_id": { "type": "string", "pattern": "^T[0-9]+$" },
        "attacker_position": { "type": "string", "minLength": 1 },
        "prerequisite_summary": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "threat": {
      "type": "object",
      "required": [
        "id",
        "scenario",
        "diagram_referent",
        "stride",
        "phantom_b",
        "cia",
        "action"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^T[0-9]+$" },
        "scenario": { "type": "string", "minLength": 20 },
        "diagram_referent": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "control_absences ids used as diagram evidence for the scenario."
        },
        "attacker_position": { "type": "string" },
        "asset": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["stride", "phantom-b", "both", "kill-chain"]
        },
        "stride": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["S", "T", "R", "I", "D", "E"]
          }
        },
        "phantom_b": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["P", "H", "A", "N", "T", "O", "M", "B"]
          }
        },
        "cia": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["C", "I", "A"]
          }
        },
        "action": {
          "type": "object",
          "required": ["type", "detail"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["mitigate", "eliminate", "transfer", "accept"]
            },
            "detail": { "type": "string" },
            "control_point": {
              "type": "string",
              "description": "Inventory component, data-store, data-flow, or trust-boundary id where the action is applied."
            },
            "validation": {
              "oneOf": [
                { "$ref": "#/$defs/validation" },
                { "type": "null" }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": { "enum": ["mitigate", "eliminate"] }
                }
              },
              "then": {
                "required": ["control_point", "validation"],
                "properties": {
                  "control_point": { "type": "string", "minLength": 1 },
                  "validation": { "$ref": "#/$defs/validation" }
                }
              }
            }
          ]
        },
        "citations": {
          "type": "object",
          "properties": {
            "owasp_llm_top10": { "type": ["string", "null"] },
            "ai_exchange_slug": { "type": ["string", "null"] },
            "atlas": { "type": ["string", "null"] }
          }
        },
        "srf": {
          "type": ["object", "null"],
          "properties": {
            "layer": {
              "type": ["string", "null"],
              "enum": ["L1", "L2", "L3", "L4", "L5", null]
            },
            "affected_layers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["L1", "L2", "L3", "L4", "L5"]
              }
            },
            "persona": { "type": ["string", "null"] },
            "party": {
              "type": ["string", "null"],
              "enum": ["customer", "provider", null]
            },
            "join": {
              "type": "object",
              "properties": {
                "ai_exchange_slug": { "type": ["string", "null"] },
                "copied_from_threats_json": { "type": "boolean" }
              }
            },
            "note": { "type": "string" }
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "required": [
        "llm_subset_empty",
        "phantom_b_complete",
        "stride_considered",
        "control_points_bound",
        "report_present",
        "open_assumptions",
        "gaps"
      ],
      "properties": {
        "inventory_components_in_solS": { "type": "boolean" },
        "boundary_crossings_covered": { "type": "boolean" },
        "llm_subset_empty": { "type": "boolean" },
        "phantom_b_complete": {
          "type": ["boolean", "null"],
          "description": "Null when llm_subset_empty is true and PHANTOM-B is not applicable."
        },
        "stride_considered": { "type": "boolean" },
        "actions_complete": { "type": "boolean" },
        "adversary_stated": { "type": "boolean" },
        "existing_controls_listed": { "type": "boolean" },
        "control_absences_grounded": { "type": "boolean" },
        "claim_boundary_stated": { "type": "boolean" },
        "actions_have_validation": { "type": "boolean" },
        "control_points_bound": { "type": "boolean" },
        "attacker_positions_bound": { "type": "boolean" },
        "evidence_refs_bound": { "type": "boolean" },
        "replica_coverage_complete": { "type": "boolean" },
        "review_order_complete": { "type": "boolean" },
        "report_present": { "type": "boolean" },
        "open_assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
