{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisharedresponsibility.com/eval/threat-model/schema.json",
  "title": "AI-enabled system threat matrix v3",
  "description": "JSON shape written by prompt pack v3. It records review context, traditional and AI-specific method coverage, composition paths, source provenance, importance, optional SRF accountability, and optional vertical obligations.",
  "type": "object",
  "required": [
    "system_name",
    "perspective",
    "representation",
    "inventory",
    "solution_description",
    "llm_subset",
    "llm_subset_empty",
    "review_context",
    "traditional_coverage",
    "stride_coverage",
    "phantom_coverage",
    "composition_coverage",
    "source_manifest",
    "threats",
    "qa"
  ],
  "additionalProperties": true,
  "properties": {
    "system_name": { "type": "string", "minLength": 1 },
    "perspective": { "type": "string", "minLength": 1 },
    "representation": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["image", "mermaid", "svg"] },
        "sha256": { "type": "string" },
        "source_id": { "type": "string" },
        "version": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "inventory": { "$ref": "#/$defs/inventory" },
    "architecture_description": { "type": "string" },
    "application_details": { "type": "string" },
    "key_features": {
      "type": "array",
      "items": { "type": "string" }
    },
    "in_scope": {
      "type": "array",
      "items": { "$ref": "#/$defs/scope_item" }
    },
    "out_of_scope": {
      "type": "array",
      "items": { "$ref": "#/$defs/scope_item" }
    },
    "replica_coverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/replica_coverage" }
    },
    "adversary": { "$ref": "#/$defs/adversary" },
    "existing_controls": {
      "type": "array",
      "items": { "$ref": "#/$defs/existing_control" }
    },
    "control_absences": {
      "type": "array",
      "items": { "$ref": "#/$defs/control_absence" }
    },
    "none_drawn": { "type": "boolean" },
    "claim_boundary": { "$ref": "#/$defs/claim_boundary" },
    "solution_description": { "type": "string" },
    "report": { "$ref": "#/$defs/report" },
    "llm_subset": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Component ids that receive PHANTOM-B elicitation."
    },
    "llm_subset_empty": {
      "type": "boolean",
      "description": "True exactly when llm_subset is empty. An empty subset makes PHANTOM-B not applicable, not complete."
    },
    "llm_subset_decision": { "$ref": "#/$defs/llm_subset_decision" },
    "review_context": { "$ref": "#/$defs/review_context" },
    "traditional_coverage": { "$ref": "#/$defs/phase_coverage" },
    "stride_considerations": {
      "type": "array",
      "items": { "$ref": "#/$defs/stride_consideration" }
    },
    "stride_coverage": { "$ref": "#/$defs/stride_coverage" },
    "phantom_considerations": {
      "type": "array",
      "items": { "$ref": "#/$defs/consideration" }
    },
    "phantom_coverage": { "$ref": "#/$defs/phantom_coverage" },
    "abuse_considerations": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario_consideration" }
    },
    "abuse_coverage": { "$ref": "#/$defs/phase_coverage" },
    "operational_considerations": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenario_consideration" }
    },
    "operational_coverage": { "$ref": "#/$defs/phase_coverage" },
    "composition_considerations": {
      "type": "array",
      "items": { "$ref": "#/$defs/composition_consideration" }
    },
    "composition_coverage": { "$ref": "#/$defs/composition_coverage" },
    "source_manifest": { "$ref": "#/$defs/source_manifest" },
    "vertical_context": {
      "type": "object",
      "additionalProperties": true
    },
    "srf_scope": {
      "oneOf": [
        { "type": "object", "additionalProperties": true },
        { "type": "array", "items": { "type": "string", "minLength": 1 } },
        { "type": "string", "minLength": 1 }
      ]
    },
    "layer_coverage": { "$ref": "#/$defs/layer_coverage" },
    "threats": {
      "type": "array",
      "items": { "$ref": "#/$defs/threat" }
    },
    "review_order": {
      "type": "array",
      "items": { "$ref": "#/$defs/review_order_item" }
    },
    "qa": { "$ref": "#/$defs/qa" },
    "chain_meta": {
      "type": "object",
      "required": ["prompt_pack_version", "track_b_applied", "track_c_applied"],
      "properties": {
        "prompt_pack_version": {
          "type": "string",
          "const": "3.0",
          "description": "Must equal the root version in prompts.json."
        },
        "role": { "type": "string" },
        "method": { "type": "string" },
        "date": { "type": "string" },
        "reviewer": { "type": ["string", "null"] },
        "track_b_applied": { "type": "boolean" },
        "track_c_applied": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["llm_subset_empty"],
        "properties": {
          "llm_subset_empty": { "const": true }
        }
      },
      "then": {
        "properties": {
          "llm_subset": { "type": "array", "maxItems": 0 },
          "phantom_coverage": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "const": "not_applicable" }
            }
          },
          "qa": {
            "type": "object",
            "required": ["llm_subset_empty", "phantom_b_complete"],
            "properties": {
              "llm_subset_empty": { "const": true },
              "phantom_b_complete": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["llm_subset_empty"],
        "properties": {
          "llm_subset_empty": { "const": false }
        }
      },
      "then": {
        "properties": {
          "llm_subset": { "type": "array", "minItems": 1 },
          "phantom_coverage": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {
                "enum": ["complete", "incomplete"]
              }
            }
          },
          "qa": {
            "type": "object",
            "required": ["llm_subset_empty", "phantom_b_complete"],
            "properties": {
              "llm_subset_empty": { "const": false },
              "phantom_b_complete": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["review_context"],
        "properties": {
          "review_context": {
            "type": "object",
            "required": ["profile"],
            "properties": {
              "profile": { "type": "string", "enum": ["full-system", "bounded-subsystem"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "traditional_coverage": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "enum": ["complete", "incomplete"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["review_context"],
        "properties": {
          "review_context": {
            "type": "object",
            "required": ["profile"],
            "properties": {
              "profile": { "type": "string", "const": "artifact-only" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_context": {
            "type": "object",
            "required": ["profile_confirmation"],
            "properties": {
              "profile_confirmation": {
                "type": "object",
                "required": ["operator_confirmed"],
                "properties": {
                  "operator_confirmed": {
                    "type": "boolean",
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["traditional_coverage"],
        "properties": {
          "traditional_coverage": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "const": "not_applicable" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_context": {
            "type": "object",
            "required": ["profile"],
            "properties": {
              "profile": { "type": "string", "const": "artifact-only" }
            }
          },
          "traditional_coverage": {
            "type": "object",
            "required": ["operator_confirmation"],
            "properties": {
              "operator_confirmation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["chain_meta"],
        "properties": {
          "chain_meta": {
            "type": "object",
            "required": ["track_b_applied"],
            "properties": {
              "track_b_applied": { "type": "boolean", "const": true }
            }
          }
        }
      },
      "then": {
        "required": ["layer_coverage"],
        "properties": {
          "layer_coverage": { "$ref": "#/$defs/layer_coverage" },
          "review_context": {
            "type": "object",
            "required": ["operating_model"],
            "properties": {
              "operating_model": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["chain_meta"],
        "properties": {
          "chain_meta": {
            "type": "object",
            "required": ["track_c_applied"],
            "properties": {
              "track_c_applied": { "type": "boolean", "const": true }
            }
          }
        }
      },
      "then": {
        "required": ["vertical_context"],
        "properties": {
          "vertical_context": {
            "type": "object",
            "additionalProperties": true
          },
          "chain_meta": {
            "type": "object",
            "required": ["track_b_applied"],
            "properties": {
              "track_b_applied": { "type": "boolean", "const": true }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "review_context": {
      "type": "object",
      "required": [
        "profile",
        "profile_confirmation",
        "perspective",
        "vertical_ids",
        "jurisdictions",
        "operating_model",
        "critical_assets",
        "prohibited_outcomes",
        "continuity_safety_constraints",
        "supplied_severity",
        "scope",
        "claim_evidence"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["full-system", "bounded-subsystem", "artifact-only"]
        },
        "profile_confirmation": {
          "type": "object",
          "required": ["operator_confirmed", "evidence_ref"],
          "properties": {
            "operator_confirmed": { "type": "boolean" },
            "evidence_ref": {
              "type": ["string", "null"],
              "minLength": 1
            }
          }
        },
        "perspective": { "type": "string", "minLength": 1 },
        "vertical_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "jurisdictions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "operating_model": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "critical_assets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/critical_asset" }
        },
        "prohibited_outcomes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/prohibited_outcome" }
        },
        "continuity_safety_constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/continuity_safety_constraint" }
        },
        "supplied_severity": {
          "oneOf": [
            {
              "type": "object",
              "required": ["value", "scale", "source"],
              "properties": {
                "value": { "type": "string", "minLength": 1 },
                "scale": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "scope": {
          "type": "object",
          "required": [
            "included_labels",
            "excluded_labels",
            "boundary_statement"
          ],
          "properties": {
            "included_labels": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "excluded_labels": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "boundary_statement": { "type": "string" }
          }
        },
        "claim_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/claim_evidence" }
        }
      }
    },
    "claim_evidence": {
      "type": "object",
      "required": ["id", "kind", "reference", "supports"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^claim-"
        },
        "kind": {
          "type": "string",
          "enum": ["diagram", "operator"]
        },
        "reference": { "type": "string", "minLength": 1 },
        "supports": { "type": "string", "minLength": 1 }
      }
    },
    "critical_asset": {
      "type": "object",
      "required": ["id", "name", "diagram_referents", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "diagram_referents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prohibited_outcome": {
      "type": "object",
      "required": ["id", "statement", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "continuity_safety_constraint": {
      "type": "object",
      "required": ["id", "statement", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "phase_coverage": {
      "type": "object",
      "required": [
        "status",
        "expected_referents",
        "considered_referents",
        "exclusions",
        "operator_confirmation",
        "gaps"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["complete", "incomplete", "not_applicable"]
        },
        "expected_referents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "considered_referents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["referent", "reason"],
                "properties": {
                  "referent": { "type": "string", "minLength": 1 },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        },
        "operator_confirmation": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scenario_consideration": {
      "type": "object",
      "required": ["status", "diagram_referent", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "element_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["scenario", "not_applicable"]
        },
        "scenario": { "type": "string" },
        "reason": { "type": "string" },
        "diagram_referent": { "type": "string", "minLength": 1 },
        "referents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "preconditions": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "attacker_position": { "type": "string" },
        "asset": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "const": "scenario" }
            }
          },
          "then": {
            "required": ["scenario"],
            "properties": {
              "scenario": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "const": "not_applicable" }
            }
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "composition_path": {
      "type": "object",
      "required": ["id", "kind", "referents"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "referents": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "composition_coverage": {
      "type": "object",
      "required": [
        "expected_paths",
        "considered_paths",
        "remaining_paths",
        "status"
      ],
      "properties": {
        "expected_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/composition_path" }
        },
        "considered_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "remaining_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "type": "string",
          "enum": ["complete", "incomplete", "not_applicable"]
        }
      }
    },
    "composition_consideration": {
      "type": "object",
      "required": [
        "path_id",
        "status",
        "diagram_referent",
        "referents",
        "evidence_refs"
      ],
      "properties": {
        "path_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["scenario", "not_applicable"]
        },
        "diagram_referent": { "type": "string", "minLength": 1 },
        "referents": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string" },
        "scenario": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "const": "scenario" }
            }
          },
          "then": {
            "required": ["scenario"],
            "properties": {
              "scenario": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "const": "not_applicable" }
            }
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "source_manifest": {
      "type": "object",
      "required": ["source_set_id", "entries"],
      "properties": {
        "source_set_id": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "source_kind",
              "canonical_url",
              "license_id",
              "integration_mode",
              "catalog_version",
              "retrieved_at",
              "content_sha256"
            ],
            "properties": {
              "source_id": { "type": "string", "minLength": 1 },
              "source_kind": { "type": "string", "minLength": 1 },
              "canonical_url": { "type": "string", "minLength": 1 },
              "license_id": { "type": "string", "minLength": 1 },
              "integration_mode": { "type": "string", "minLength": 1 },
              "catalog_version": { "type": "string", "minLength": 1 },
              "retrieved_at": { "type": "string", "minLength": 1 },
              "content_sha256": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "layer_coverage": {
      "type": "object",
      "required": [
        "status",
        "expected_layers",
        "considered_layers",
        "remaining_layers"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["complete", "incomplete", "not_applicable"]
        },
        "expected_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["L1", "L2", "L3", "L4", "L5"]
          }
        },
        "considered_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["L1", "L2", "L3", "L4", "L5"]
          }
        },
        "remaining_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["L1", "L2", "L3", "L4", "L5"]
          }
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "adversary": {
      "type": "object",
      "properties": {
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "positions": {
          "type": "array",
          "items": { "$ref": "#/$defs/attacker_position" }
        }
      }
    },
    "attacker_position": {
      "type": "object",
      "required": ["id", "zone", "actor", "already_can"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "zone": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
