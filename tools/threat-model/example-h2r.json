  "disclaimer": "Prototype. Every owner is a placeholder. Every obligation is unverified. This is not legal advice. Not part of CoSAI SRF v1.0.",
  "id": "sys.h2r-agentic",
  "name": "Agentic Hire to Retire (example)",
  "description": "A hire-to-retire process run by an orchestration agent and five sub-agents. The orchestrator runs on a reasoning LLM from an AI Model Provider. Hard rules (offer authority, required postings, background-check gates, access revocation, segregation of duties) are enforced by a policy service outside the model. Background-check scoring is a separate component that is not on the reasoning-LLM path.",
  "operating_model": "Agent-PaaS",
  "operating_model_note": "Example assumption. Bill to confirm.",
  "as_of": "2026-11-16",
  "snapshot_id": null,
  "overlays_enabled": []
 },
