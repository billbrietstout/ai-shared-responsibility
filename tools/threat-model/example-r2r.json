 "system": {
  "id": "sys.r2r-agentic",
  "name": "Agentic Record to Report (example)",
  "description": "A financial close and reporting process run by an orchestration agent and five sub-agents. The orchestrator runs on a reasoning LLM from an AI Model Provider. Hard rules (period lock, materiality thresholds, late-adjustment approval, segregation of duties) are enforced by a policy service outside the model. Journal anomaly detection is a separate component that is not on the reasoning-LLM path.",
  "operating_model": "Agent-PaaS",
  "operating_model_note": "Example assumption. Bill to confirm.",
  "as_of": "2026-11-16",
  "snapshot_id": null,
  "overlays_enabled": []
 },
